<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <decorator-prefix>/WEB-INF/decorators/</decorator-prefix>
    <dispatch-mode>include</dispatch-mode>
    <include-error-pages>true</include-error-pages>
    <mapping path="/*" name="web" decorator="web.jsp" />
    <mapping path="/dashboard" name="admin" decorator="admin.jsp" />
    <mapping path="/admin/*" name="admin" decorator="admin.jsp" />
    <mapping path="/api*" exclude="true" />
    <mapping path="/css/*" exclude="true" />
    <mapping path="/templates/*" exclude="true" />
    <mapping path="/js/*" exclude="true" />
    <mapping path="/images/*" exclude="true" />
    <mapping path="/videos/*" exclude="true" />
    <mapping path="/image" exclude="true" />
    <mapping path="/product-image/*" exclude="true" />
    <mapping path="/video-file" exclude="true" />
</sitemesh>
